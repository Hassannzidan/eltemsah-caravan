        [ngClass]="{
          'translate-x-full': isActive,
          'translate-x-0': !isActive
        }"
        [ngStyle]="{
          transformOrigin: 'left',
          zIndex: 20
        }"
      ></div>

      <!-- Title -->
      <div
        class="inline-flex items-center rounded-full border border-white/30 px-6 py-2 text-lg font-semibold text-white bg-white/20 backdrop-blur-md relative overflow-hidden"
      >
        {{ slide.title | translate }}
      </div>

